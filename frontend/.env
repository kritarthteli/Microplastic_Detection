# ── Inference API Configuration ─────────────────────────────────────────────
#
# Set to "false" to point at a live Python backend instead of using mock data.
# Default: "true" (mock mode — no backend required)
VITE_USE_MOCK=true

# Base URL for the Python backend API (used only when VITE_USE_MOCK=false)
# In development, Vite proxies /api → http://localhost:8000 (see vite.config.js)
# In production, set this to your deployed backend URL.
VITE_API_BASE=/api

